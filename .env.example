# Localhost evaluation only. Prefer install.py init to generate private values.
# No license-signing private key or public-key override belongs here.
REPLAYGUARD_PROJECT_NAME=replayguard-community
REPLAYGUARD_HTTP_PORT=8080
POSTGRES_DB=replayguard_community
POSTGRES_USER=replayguard_community
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_32_OR_MORE_CHARACTERS
REPLAYGUARD_ADMIN_USERNAME=admin
REPLAYGUARD_ADMIN_EMAIL=REPLACE_WITH_YOUR_ADMIN_EMAIL
REPLAYGUARD_ADMIN_DISPLAY_NAME=ReplayGuard Administrator
REPLAYGUARD_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_32_OR_MORE_CHARACTERS
REPLAYGUARD_JWT_SECRET=REPLACE_WITH_RANDOM_32_OR_MORE_CHARACTERS
REPLAYGUARD_PROFILE_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_RANDOM_BYTES
REPLAYGUARD_LICENSE_KEY=
